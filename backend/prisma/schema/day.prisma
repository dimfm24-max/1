// The day: what a person plans, and the settings that shape how it is shown. Delete this file
// and the matching block in base.prisma to remove the capability entirely.

enum TaskPriority {
  normal
  important
  urgent

  @@map("task_priority")
}

enum TaskOutcome {
  /// Still on the day, done or not.
  planned
  done
  /// The person chose to let it go rather than carry it forward. Kept in history: a day is
  /// honest about what did not happen.
  burned

  @@map("task_outcome")
}

/// How a repeating thing picks its days: every day, chosen weekdays, chosen days of the month, or
/// chosen dates. Shared by repeating tasks (task 18) and templates applied by themselves (task 17).
enum ScheduleRuleKind {
  daily
  weekdays
  monthdays
  dates

  @@map("schedule_rule_kind")
}

/// What the day module remembers about a person once: that the starter categories were offered,
/// so deleting them all does not bring them back (owner's decision on task 14).
model DayProfile {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  starterCategoriesAt DateTime? @map("starter_categories_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "day_profiles_user_id_fkey")

  @@map("day_profiles")
}

/// A repeating task (task 18). The rule lives here; each day it lands on is an ordinary task made
/// from it for the next days, so each occurrence is done, moved or burned on its own.
model TaskSeries {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title           String
  description     String?
  startMinute     Int?         @map("start_minute")
  durationMinutes Int          @map("duration_minutes")
  priority        TaskPriority @default(normal)
  categoryId      String?      @map("category_id") @db.Uuid
  colorOverride   String?      @map("color_override")

  ruleKind  ScheduleRuleKind @map("rule_kind")
  /// 0-6 with Sunday at 0, as habits count them, for `weekdays`.
  weekdays  Int[]            @default([])
  /// 1-31 for `monthdays`; 29-31 fall on the last day of a shorter month.
  monthDays Int[]            @default([]) @map("month_days")
  /// The chosen days for `dates`.
  dates     DateTime[]       @db.Date

  startsOn DateTime  @map("starts_on") @db.Date
  /// Last day included; null repeats without end.
  endsOn   DateTime? @map("ends_on") @db.Date

  /// Days never to make again: an occurrence deleted for good, or taken out of the series.
  excludedDates DateTime[] @default([]) @map("excluded_dates") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "task_series_user_id_fkey")
  tasks Task[]

  @@index([userId], map: "task_series_user_id_idx")
  @@map("task_series")
}

/// Colour and grouping for tasks: work, sport, family. The person's own list, not a fixed one.
model TaskCategory {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title String
  /// A hex colour the interface renders directly. Validated by the contract, not the database.
  color    String
  position Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "task_categories_user_id_fkey")
  tasks Task[]

  @@index([userId, position], map: "task_categories_user_id_position_idx")
  @@map("task_categories")
}

model Task {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The calendar day this task sits on, as a date rather than a moment: moving a task to
  /// tomorrow must not depend on the hour it was created.
  scheduledOn DateTime @map("scheduled_on") @db.Date

  /// Minutes past midnight. Null means the task belongs to the day but not to a time - a chore
  /// that has to happen today, with no hour attached.
  startMinute     Int? @map("start_minute")
  durationMinutes Int  @default(30) @map("duration_minutes")

  title       String
  description String?
  priority    TaskPriority @default(normal)
  outcome     TaskOutcome  @default(planned)
  completedAt DateTime?    @map("completed_at")

  /// Set when this task came from another day, so the day screen can say so rather than
  /// pretending it was always here.
  movedFrom DateTime? @map("moved_from") @db.Date

  /// A colour that overrides the category's, for a task a person wants to stand out.
  colorOverride String? @map("color_override")

  categoryId String? @map("category_id") @db.Uuid

  /// The step of a goal this task advances. Optional on purpose: errands are not goals, and
  /// forcing every task under a goal would push chores out of the plan instead of into it.
  stepId String? @map("step_id") @db.Uuid

  position Int

  /// The series this task is an occurrence of, and the day the series put it on. The pair is
  /// unique, so making occurrences twice never doubles a day, even after the task was moved.
  seriesId   String?   @map("series_id") @db.Uuid
  seriesDate DateTime? @map("series_date") @db.Date
  /// Changed on its own («только эта»): later edits of the series leave it alone.
  seriesDetached Boolean @default(false) @map("series_detached")

  /// In the trash since this moment; purged 30 days later (task 11). Every reader skips it.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "tasks_user_id_fkey")
  category TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "tasks_category_id_fkey")
  step     GoalStep?     @relation(fields: [stepId], references: [id], onDelete: SetNull, map: "tasks_step_id_fkey")
  series   TaskSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull, map: "tasks_series_id_fkey")
  subtasks TaskSubtask[]

  @@index([userId, scheduledOn], map: "tasks_user_id_scheduled_on_idx")
  @@index([stepId], map: "tasks_step_id_idx")
  @@index([deletedAt], map: "tasks_deleted_at_idx")
  @@unique([seriesId, seriesDate], map: "tasks_series_id_series_date_key")
  @@map("tasks")
}

model TaskSubtask {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId String @map("task_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  title       String
  completedAt DateTime? @map("completed_at")
  position    Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "task_subtasks_task_id_fkey")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "task_subtasks_user_id_fkey")

  @@index([taskId, position], map: "task_subtasks_task_id_position_idx")
  @@map("task_subtasks")
}

/// A named shape of a day - weekday, day off, training day - that a person applies to build
/// tomorrow instead of typing it again.
model DayTemplate {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  title    String
  position Int

  /// Applied by itself on matching days (task 17); null means by hand only.
  ruleKind  ScheduleRuleKind? @map("rule_kind")
  weekdays  Int[]             @default([])
  monthDays Int[]             @default([]) @map("month_days")
  /// From this day on; automatic application never reaches back before the rule was set.
  ruleFrom  DateTime?         @map("rule_from") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "day_templates_user_id_fkey")
  items        DayTemplateItem[]
  applications DayTemplateApplication[]

  @@index([userId, position], map: "day_templates_user_id_position_idx")
  @@map("day_templates")
}

model DayTemplateItem {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  title           String
  startMinute     Int?         @map("start_minute")
  durationMinutes Int          @default(30) @map("duration_minutes")
  priority        TaskPriority @default(normal)
  categoryId      String?      @map("category_id") @db.Uuid
  position        Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  template DayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, map: "day_template_items_template_id_fkey")
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "day_template_items_user_id_fkey")

  @@index([templateId, position], map: "day_template_items_template_id_position_idx")
  @@map("day_template_items")
}

/// A template was applied to a day: by hand or by its rule. Automatic application looks here
/// first, so a day gets a template once, and tasks deleted from it do not come back (task 17).
model DayTemplateApplication {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  appliedOn  DateTime @map("applied_on") @db.Date
  automatic  Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  template DayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, map: "day_template_applications_template_id_fkey")
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "day_template_applications_user_id_fkey")

  @@unique([templateId, appliedOn], map: "day_template_applications_template_id_applied_on_key")
  @@index([userId, appliedOn], map: "day_template_applications_user_id_applied_on_idx")
  @@map("day_template_applications")
}
